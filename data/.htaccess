Options -Indexes
<FilesMatch "^(?!content\.json$).*$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  <Files "content.json">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
