# Uploaded files are data only. Kept minimal so it works on every
# DirectAdmin / Apache / LiteSpeed host (some reject Options / RemoveType here).
# The admin already only saves .3mf / png / jpg / webp / gif with random names.
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|pl|py|cgi|sh|html|htm|svg|PHP|PHTML|PHAR)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
